---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "mock-form | Open Source AI Form Autofill for Chrome",
  description = "Lightweight, privacy-focused open-source Chrome extension powered by Google Gemini AI to inspect, mock, and auto-fill web forms and upload images."
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL 
  : `${import.meta.env.BASE_URL}/`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={`${baseUrl}icons/icon48.png`} />
    <meta name="theme-color" content="#09090b" />
    
    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${baseUrl}icons/icon128.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

    <!-- Anti-FOUC Theme Detection Script -->
    <script is:inline>
      (function() {
        const savedTheme = localStorage.getItem('theme');
        if (savedTheme === 'light') {
          document.documentElement.classList.add('light');
        } else {
          document.documentElement.classList.remove('light');
        }
      })();
    </script>
  </head>
  <body>
    <slot />

    <!-- Toast HUD for notifications -->
    <div id="toast-hud" class="toast-hud success" role="status" aria-live="polite">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 6 9 17l-5-5"/>
      </svg>
      <span id="toast-message">Copied to clipboard</span>
    </div>

    <script is:inline>
      window.showToast = function(message, type = 'success', duration = 2500) {
        const toast = document.getElementById('toast-hud');
        const text = document.getElementById('toast-message');
        if (!toast || !text) return;
        text.textContent = message;
        toast.className = `toast-hud ${type} show`;
        clearTimeout(window.__toastTimer);
        window.__toastTimer = setTimeout(() => {
          toast.classList.remove('show');
        }, duration);
      };
    </script>
  </body>
</html>
