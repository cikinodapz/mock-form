---
const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL 
  : `${import.meta.env.BASE_URL}/`;

const githubRepo = "https://github.com/cikinodapz/mock-form";
---

<header class="navbar-wrapper">
  <div class="container navbar-container">
    <!-- Brand -->
    <a href={`${baseUrl}`} class="brand">
      <img 
        src={`${baseUrl}icons/logo-ui.png`} 
        alt="mock-form logo" 
        class="brand-icon" 
        width="28" 
        height="28" 
      />
      <span class="brand-text">mock-form</span>
      <span class="brand-badge">OSS</span>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="nav-links">
      <a href="#features" class="nav-link">Features</a>
      <a href="#playground" class="nav-link">Playground</a>
      <a href="#models" class="nav-link">Models</a>
      <a href="#shortcuts" class="nav-link">Shortcuts</a>
      <a href="#install" class="nav-link">Install</a>
    </nav>

    <!-- Right CTAs -->
    <div class="nav-actions">
      <a 
        href={githubRepo} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="btn btn-secondary github-btn"
        title="View source on GitHub"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
        <span class="github-text">GitHub</span>
        <span class="star-badge">★ Star</span>
      </a>

      <!-- Theme Toggle Button -->
      <button id="theme-toggle" class="btn btn-ghost theme-toggle-btn" aria-label="Toggle light/dark theme" title="Toggle theme">
        <svg class="sun-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2"/>
          <path d="M12 20v2"/>
          <path d="m4.93 4.93 1.41 1.41"/>
          <path d="m17.66 17.66 1.41 1.41"/>
          <path d="M2 12h2"/>
          <path d="M20 12h2"/>
          <path d="m6.34 17.66-1.41 1.41"/>
          <path d="m19.07 4.93-1.41 1.41"/>
        </svg>
        <svg class="moon-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
        </svg>
      </button>

      <a href="#playground" class="btn btn-primary demo-btn">
        <span>Try Demo</span>
      </a>

      <!-- Mobile Menu Toggle -->
      <button id="mobile-toggle" class="mobile-toggle" aria-label="Toggle navigation menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="4" x2="20" y1="12" y2="12"/>
          <line x1="4" x2="20" y1="6" y2="6"/>
          <line x1="4" x2="20" y1="18" y2="18"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown -->
  <div id="mobile-menu" class="mobile-menu">
    <a href="#features" class="mobile-link">Features</a>
    <a href="#playground" class="mobile-link">Playground</a>
    <a href="#models" class="mobile-link">Models</a>
    <a href="#shortcuts" class="mobile-link">Shortcuts</a>
    <a href="#install" class="mobile-link">Install Guide</a>
    <div class="mobile-theme-row">
      <span>Appearance</span>
      <button id="mobile-theme-toggle" class="btn btn-secondary btn-sm" aria-label="Toggle theme">
        <span class="mobile-theme-label">Toggle Theme ☀/☾</span>
      </button>
    </div>
    <a href={githubRepo} target="_blank" rel="noopener noreferrer" class="mobile-link mobile-link-highlight">
      View GitHub Repository ↗
    </a>
  </div>
</header>

<style>
  .navbar-wrapper {
    position: sticky;
    top: 0;
    z-index: 1000;
    width: 100%;
    background: rgba(9, 9, 11, 0.82);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border);
    transition: all 0.2s ease;
  }

  .navbar-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .brand-icon {
    width: 28px;
    height: 28px;
    filter: brightness(0) invert(1); /* Monochrome white logo */
    filter: drop-shadow(0 2px 5px rgba(0,0,0,0.2)) brightness(0) invert(1);
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .brand:hover .brand-icon {
    transform: rotate(-10deg) scale(1.05);
  }

  .brand-text {
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text);
    white-space: nowrap;
  }

  .brand-badge {
    font-size: 10px;
    font-weight: 600;
    padding: 2px 6px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-muted);
    border: 1px solid var(--border);
    flex-shrink: 0;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .nav-link {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-muted);
    transition: color 0.15s ease;
  }

  .nav-link:hover {
    color: var(--text);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .github-btn {
    font-size: 13px;
    padding: 7px 12px;
    gap: 8px;
    white-space: nowrap;
  }

  .star-badge {
    font-size: 11px;
    font-weight: 600;
    padding: 1px 6px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.1);
    color: var(--text-secondary);
  }

  .demo-btn {
    font-size: 13px;
    padding: 7px 14px;
  }

  .mobile-toggle {
    display: none;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text);
    padding: 6px;
    cursor: pointer;
    align-items: center;
    justify-content: center;
  }

  .mobile-menu {
    display: none;
    flex-direction: column;
    padding: 16px 24px;
    background: #09090b;
    border-bottom: 1px solid var(--border);
  }

  .mobile-menu.open {
    display: flex;
  }

  .mobile-link {
    padding: 10px 0;
    font-size: 14px;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border-subtle);
  }

  .mobile-link:hover {
    color: var(--text);
  }

  .mobile-link-highlight {
    color: #f8fafc;
    font-weight: 600;
    margin-top: 8px;
    border-bottom: none;
  }

  .theme-toggle-btn {
    padding: 7px;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    border: 1px solid var(--border);
    transition: all 0.15s ease;
  }

  .theme-toggle-btn:hover {
    color: var(--text);
    background: rgba(255, 255, 255, 0.08);
  }

  html.light .theme-toggle-btn:hover {
    background: rgba(15, 23, 42, 0.06);
  }

  /* Sun/Moon icon visibility toggling */
  .sun-icon {
    display: block;
  }
  .moon-icon {
    display: none;
  }

  :global(html.light) .sun-icon {
    display: none;
  }
  :global(html.light) .moon-icon {
    display: block;
  }

  .mobile-theme-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 0;
    border-bottom: 1px solid var(--border-subtle);
    font-size: 14px;
    color: var(--text-muted);
  }

  .mobile-theme-label {
    font-size: 12px;
    font-weight: 500;
  }

  @media (max-width: 860px) {
    .nav-links, .demo-btn {
      display: none;
    }
    .mobile-toggle {
      display: flex;
    }
  }

  @media (max-width: 640px) {
    .github-text, .star-badge {
      display: none;
    }
    .github-btn {
      padding: 7px 9px;
      gap: 0;
    }
  }

  @media (max-width: 420px) {
    .github-btn {
      display: none;
    }
  }
</style>

<script is:inline>
  // Mobile drawer toggle
  const toggleBtn = document.getElementById('mobile-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggleBtn && menu) {
    toggleBtn.addEventListener('click', () => {
      menu.classList.toggle('open');
    });
    menu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        menu.classList.remove('open');
      });
    });
  }

  // Theme switcher logic
  const themeToggle = document.getElementById('theme-toggle');
  const mobileThemeToggle = document.getElementById('mobile-theme-toggle');

  function toggleThemeMode() {
    const isLight = document.documentElement.classList.toggle('light');
    localStorage.setItem('theme', isLight ? 'light' : 'dark');
    if (window.showToast) {
      window.showToast(isLight ? "Switched to Light Theme" : "Switched to Dark Theme", "info", 1500);
    }
  }

  if (themeToggle) {
    themeToggle.addEventListener('click', toggleThemeMode);
  }
  if (mobileThemeToggle) {
    mobileThemeToggle.addEventListener('click', toggleThemeMode);
  }
</script>
