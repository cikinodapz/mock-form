---
const features = [
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>`,
    title: "Context-Aware AI Autofill",
    description: "Inspects full DOM hierarchies, labels, placeholders, aria attributes, and select options to infer context and generate coherent, realistic mock data.",
    badge: "Gemini 3.7 / 3.1"
  },
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>`,
    title: "Indonesia & QA Presets",
    description: "Built-in generation for 16-digit valid NIK, NPWP, 08xx WhatsApp numbers, Luhn-compliant credit cards, UUID v4, IPv4, and HTML5 regex patterns.",
    badge: "Regional & QA"
  },
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>`,
    title: "Image & Avatar Injection",
    description: "Inject realistic mock avatar photos directly into standard file inputs (<input type='file'>) and custom drag-and-drop uploader components with 1-click.",
    badge: "File Uploaders"
  },
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 16 4-4-4-4"/><path d="m6 8-4 4 4 4"/><path d="m14.5 4-5 16"/></svg>`,
    title: "Framework Reactivity",
    description: "Dispatches native synthetic InputEvent, ChangeEvent, and BlurEvent to ensure reactive state updates in React, Vue, Angular, Svelte, and Alpine.js.",
    badge: "State Reactive"
  },
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>`,
    title: "100% Privacy & Security",
    description: "Zero tracking, telemetry, or middleman servers. Your API key and profiles stay strictly in chrome.storage.local, calling Google AI Studio directly.",
    badge: "Client-Side Only"
  },
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="M6 8h.01"/><path d="M10 8h.01"/><path d="M14 8h.01"/><path d="M18 8h.01"/><path d="M6 12h.01"/><path d="M10 12h.01"/><path d="M14 12h.01"/><path d="M18 12h.01"/><path d="M8 16h8"/></svg>`,
    title: "Instant Keyboard Hotkeys",
    description: "Press Alt + Shift + F (Option + Shift + F on macOS) on any page to trigger instant autofill in the background without even opening the popup.",
    badge: "Alt + Shift + F"
  }
];
---

<section id="features" class="features-section">
  <div class="container">
    <div class="section-header">
      <div class="badge">
        <span class="badge-dot"></span>
        <span>Developer Superpowers</span>
      </div>
      <h2 class="section-title">Engineered for Rapid Form & QA Testing</h2>
      <p class="section-subtitle">
        Everything you need to bypass repetitive typing, simulate complex edge cases, and validate responsive web forms.
      </p>
    </div>

    <div class="features-grid">
      {features.map((feature) => (
        <div class="feature-card">
          <div class="feature-top">
            <div class="feature-icon" set:html={feature.icon} />
            <span class="feature-badge">{feature.badge}</span>
          </div>
          <h3 class="feature-title">{feature.title}</h3>
          <p class="feature-desc">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .features-section {
    padding: 80px 0;
    border-top: 1px solid var(--border-subtle);
    background: radial-gradient(circle at 50% 100%, rgba(255, 255, 255, 0.02) 0%, transparent 50%);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .feature-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 28px;
    display: flex;
    flex-direction: column;
    transition: all 0.25s ease;
    position: relative;
    overflow: hidden;
  }

  .feature-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.15), transparent);
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .feature-card:hover {
    border-color: var(--border-hover);
    transform: translateY(-2px);
    background: var(--surface-elevated);
    box-shadow: var(--shadow-md);
  }

  .feature-card:hover::before {
    opacity: 1;
  }

  .feature-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
  }

  .feature-icon {
    width: 42px;
    height: 42px;
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text);
  }

  .feature-badge {
    font-size: 11px;
    font-weight: 500;
    font-family: 'JetBrains Mono', monospace;
    padding: 2px 8px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    color: var(--text-dim);
  }

  .feature-title {
    font-size: 17px;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 10px;
  }

  .feature-desc {
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  @media (max-width: 980px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .features-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
